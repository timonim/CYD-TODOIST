#pragma once

// Copy this file to include/Secrets.h and fill in your own values.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Optional second network (e.g. work WiFi). Remove or leave empty to disable.
#define WIFI_SSID_2 "YOUR_SECOND_WIFI_NAME"
#define WIFI_PASSWORD_2 "YOUR_SECOND_WIFI_PASSWORD"
#define TODOIST_API_TOKEN "YOUR_TODOIST_API_TOKEN"

// POSIX timezone string used by configTzTime().
// Example for Israel: "IST-2IDT,M3.4.4/26,M10.5.0"
#define TIMEZONE_POSIX "IST-2IDT,M3.4.4/26,M10.5.0"
